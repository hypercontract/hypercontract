{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "packageRules": [
        {
            "matchManagers": ["dockerfile"],
            "pinDigests": true
        },
        {
            "matchManagers": ["npm"],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "npm minor and patch updates",
            "groupSlug": "npm-minor-patch"
        },
        {
            "matchManagers": ["npm"],
            "matchUpdateTypes": ["major"],
            "groupName": null,
            "groupSlug": null
        }
    ]
}
