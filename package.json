{
    "name": "hypercontract",
    "version": "0.0.0",
    "license": "MIT",
    "engines": {
        "node": "26.x"
    },
    "workspaces": ["libs/profile", "libs/express", "apps/hypercontract", "apps/hypershop"],
    "scripts": {
        "start": "npm run build && concurrently --kill-others-on-fail --names build,hypercontract,hypershop npm:watch:build npm:watch:hypercontract npm:watch:hypershop",
        "serve-hypercontract": "npm run build:hypercontract && concurrently --kill-others-on-fail --names build,hypercontract npm:watch:build:hypercontract npm:watch:hypercontract",
        "serve-hypershop": "npm run build:hypershop && concurrently --kill-others-on-fail --names build,hypershop npm:watch:build:hypershop npm:watch:hypershop",
        "watch:build": "tsc -b apps/hypercontract/tsconfig.build.json apps/hypershop/tsconfig.build.json --watch --preserveWatchOutput",
        "watch:build:hypercontract": "tsc -b apps/hypercontract/tsconfig.build.json --watch --preserveWatchOutput",
        "watch:build:hypershop": "tsc -b apps/hypershop/tsconfig.build.json --watch --preserveWatchOutput",
        "watch:hypercontract": "node --watch apps/hypercontract/dist/main.js",
        "watch:hypershop": "node --watch apps/hypershop/dist/main.js",
        "build": "tsc -b apps/hypercontract/tsconfig.build.json apps/hypershop/tsconfig.build.json && node tools/copy-assets.cjs hypercontract hypershop",
        "build:hypercontract": "tsc -b apps/hypercontract/tsconfig.build.json && node tools/copy-assets.cjs hypercontract",
        "build:hypershop": "tsc -b apps/hypershop/tsconfig.build.json && node tools/copy-assets.cjs hypershop",
        "build:test": "tsc -b apps/hypershop/tsconfig.test.json && node tools/copy-assets.cjs hypershop-test",
        "test": "npm run build:test && node --test dist/hypershop-test/app/app.spec.js",
        "test-debug": "npm run build:test && concurrently --kill-others-on-fail --names build,test npm:watch:build:test npm:watch:test",
        "watch:build:test": "tsc -b apps/hypershop/tsconfig.test.json --watch --preserveWatchOutput",
        "watch:test": "node --watch --inspect=7777 dist/hypershop-test/app/app.spec.js",
        "test-postman": "node ./postman/test.js",
        "lint": "eslint . --max-warnings 0",
        "format": "npm run format:write",
        "format:write": "eslint . --fix --fix-type layout",
        "format:check": "eslint . --max-warnings 0"
    },
    "private": true,
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "6.0.0",
        "@types/cors": "2.8.19",
        "@types/ejs": "3.1.5",
        "@types/express": "4.17.25",
        "@types/json-schema": "7.0.15",
        "@types/jsonld": "1.5.15",
        "@types/lodash": "4.17.27",
        "@types/method-override": "3.0.0",
        "@types/n3": "1.26.6",
        "@types/node": "26.6.6",
        "@types/omit-deep": "0.3.2",
        "@types/rdfjs__data-model": "2.0.9",
        "@types/rdflib": "1.2.0",
        "@types/supertest": "7.2.1",
        "ajv": "8.20.0",
        "concurrently": "10.0.7",
        "eslint": "10.15.0",
        "lodash": "4.18.1",
        "newman": "6.2.3",
        "supertest": "7.3.2",
        "tslib": "2.9.1",
        "typescript": "7.0.2",
        "typescript-eslint": "8.73.0"
    }
}
